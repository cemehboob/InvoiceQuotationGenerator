    "cap:run:ios": "npm run build && cap run ios",
    "test:platforms": "node ../scripts/verify-platforms.cjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
