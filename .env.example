# -------------------------------------------------------------
# Invoxa SaaS Platform - Environment Configuration Template
# -------------------------------------------------------------

# PostgreSQL Database Configuration
POSTGRES_DB=invoxa_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuperSecurePostgresPassword2026!
POSTGRES_PORT=5432

# Backend API Configuration
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=ReplaceWithAStrongSecretKeyAtLeast32CharactersLong2026!
JWT_ISSUER=InvoxaAPI
JWT_AUDIENCE=InvoxaClient

# Production Domain / CORS
# Add your production frontend domain or mobile app scheme
ALLOWED_ORIGINS=https://app.invoxa.com,https://invoxa.com,capacitor://localhost

# Frontend Build Time API URL (Optional, defaults to /api for web or auto-detected for mobile)
VITE_API_URL=https://api.invoxa.com/api

