{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "InvoxaAPI",
    "Audience": "InvoxaClient",
    "ExpiryMinutes": 1440
  },
  "Cors": {
    "AllowedOrigins": [
      "https://*.invoxa.com",
      "capacitor://localhost",
      "ionic://localhost",
      "http://localhost",
      "https://localhost"
    ]
  },
  "UseHttpsRedirection": false,
  "EnableSwaggerInProd": false
}
